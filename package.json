{
  "name": "cloudtime",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Self-hosted WakaTime-compatible coding time tracker on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "predev": "npm run build:css",
    "deploy": "wrangler deploy",
    "predeploy": "npm run build:css",
    "build:css": "tailwindcss -i ./src/ui/styles.css -o ./public/assets/app.css --minify",
    "watch:css": "tailwindcss -i ./src/ui/styles.css -o ./public/assets/app.css --watch",
    "bundle": "redocly bundle schemas/openapi.yaml -o schemas/_bundled/openapi.yaml",
    "generate": "redocly bundle schemas/openapi.yaml -o schemas/_bundled/openapi.yaml && openapi-typescript schemas/_bundled/openapi.yaml -o src/types/generated.ts",
    "lint:api": "redocly lint schemas/openapi.yaml",
    "db:init": "wrangler d1 execute cloudtime-db --local --file=./src/db/schema.sql",
    "db:init:remote": "wrangler d1 execute cloudtime-db --remote --file=./src/db/schema.sql",
    "tail": "wrangler tail",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@redocly/cli": "^2.64.1",
    "@tailwindcss/cli": "^4.3.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "daisyui": "^5.7.50",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1",
    "@cloudflare/vitest-plugin": "^1.4.4"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1",
    "npm": ">=10"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
